[sub_resource type="GDScript" id="GDScript_g2els"]
script/source = "extends CharacterBody2D

@export var speed = 400

var is_attacking: bool = false
var hitbox_offset: Vector2
#var screen_size
@onready var hit_box_baton: Area2D = $hitBoxBaton

# Called when the node enters the scene tree for the first time.
#func _ready() -> void:
	#screen_size = get_viewport_rect().size

func _ready() -> void:
	#hitbox ofset
	hitbox_offset = hit_box_baton.position

# Called every frame. 'delta' is the elapsed time since the previous frame. : float) -> void:
func _process(delta):
	var velocity = Vector2.ZERO #move vector
	if Input.is_action_pressed(\"move_right\"):
		velocity.x += 1
	if Input.is_action_pressed(\"move_left\"):
		velocity.x -= 1
	if Input.is_action_pressed(\"move_down\"):
		velocity.y += 1
	if Input.is_action_pressed(\"move_up\"):
		velocity.y -= 1
		
	if Input.is_action_pressed(\"attack\") and not is_attacking:
		attack()
		
	if is_attacking:
		return
	if velocity.length() > 0:
		velocity = velocity.normalized() * speed
		$AnimatedSprite2D.play() 
	else:
		$AnimatedSprite2D.animation = \"idle\"

	position += velocity * delta
		
	if velocity.x != 0:
		$AnimatedSprite2D.animation = \"leftWalking\"
		$AnimatedSprite2D.flip_v = false
		$AnimatedSprite2D.flip_h = velocity.x < 0
		
func attack () -> void:
	is_attacking = true
	$AnimatedSprite2D.animation = \"tempAttacking\"
	$AnimatedSprite2D.play() 
	#await get_tree().create_timer(1).timeout dose not do anything but i want to create a cooldown on the atack in effect attack speed
	 
	
func _on_animated_sprite_2d_animation_finished() -> void:
	if is_attacking:
		is_attacking = false
		
#hitBoxOfSet
func updat_hitbox_offset() -> void:
	var x := hitbox_offset.x
	var y := hitbox_offset.y
	
	match velocity:
		Vector2.LEFT:
			hit_box_baton.position = Vector2(-x, y)
		Vector2.RIGHT:
			hit_box_baton.position = Vector2(x, y)
		Vector2.UP:
			hit_box_baton.position = Vector2(y, -x)
		Vector2.DOWN:
			hit_box_baton.position = Vector2(-y, x)
"

